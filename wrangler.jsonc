// Lets Cloudflare deploy the built site as static assets if the project was set up
// as a Worker (deploy command `npx wrangler deploy`). Cloudflare Pages ignores this file.
{
  "name": "mordecais-study",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
